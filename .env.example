# Vite exposes VITE_-prefixed variables in the browser bundle (they are embedded
# at build time and are NOT secret — never put credentials in a VITE_ variable).

# For production (Vercel): set VITE_API_URL to your deployed backend origin.
# Replace with the real backend URL after it is deployed (no trailing slash).
VITE_API_URL=

# For local development, use:
# VITE_API_URL=http://localhost:8080
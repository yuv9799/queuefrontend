# Backend environment (copy to .env and adjust for your host)

# Port the API listens on (most hosts inject this).
PORT=8080

# Address to bind. 0.0.0.0 = all interfaces (required on most hosts).
HOST=0.0.0.0

# Node environment. When 'production', the demo-OTP bypass is disabled and a
# real OTP provider must be wired into routes/otp.js.
NODE_ENV=production

# Deployed frontend origin; also used as an allowed CORS origin.
FRONTEND_URL=https://kims-queue.vercel.app

# Additional comma-separated CORS origins (built-in origins remain allowed).
# CORS_ORIGINS=https://preview.example.com,https://other.example.com

# Path to the SQLite database file. Default: <repo>/backend/data/queue.db
# In production point this at a PERSISTENT volume.
# DB_PATH=/app/data/queue.db

# Secret used to sign JWTs. MUST be a long random value in production.
# Generate with: openssl rand -base64 48
# JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Set to 1 when running behind an HTTPS reverse proxy (Render/NGINX/Cloudflare)
# so req.protocol / req.ip reflect the real client.
# TRUST_PROXY=1

# Token SMS notifications (server-side only). Disabled by default.
SMS_ENABLED=false
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Twilio WhatsApp notifications (backend only; requires explicit patient consent)
TWILIO_WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+<TWILIO_SANDBOX_OR_APPROVED_SENDER>
TWILIO_WHATSAPP_CONTENT_SID=

# Public frontend base URL used to build the /status?id=... tracking link.
PUBLIC_APP_URL=https://kims-queue.vercel.app/

# Patient-facing KIMS AI Assistant. The current intent and booking flow runs
# locally in the backend and does not require a third-party AI API key.
AI_ENABLED=true